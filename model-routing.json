{
  "schema_version": 1,
  "default_tier": {
    "claude": "economy",
    "codex": "critical",
    "pi": "critical"
  },
  "tiers": {
    "economy": {
      "claude": {
        "model": "sonnet",
        "effort": "high"
      },
      "codex": {
        "model": "gpt-5.6-luna",
        "effort": "max"
      },
      "pi": {
        "provider": "datadog-ai-gateway",
        "model": "openai/gpt-5.6-luna",
        "thinking": "xhigh"
      }
    },
    "critical": {
      "claude": {
        "model": "opus",
        "effort": "xhigh"
      },
      "codex": {
        "model": "gpt-5.6-sol",
        "effort": "xhigh"
      },
      "pi": {
        "provider": "datadog-ai-gateway",
        "model": "openai/gpt-5.6-sol",
        "thinking": "xhigh"
      }
    }
  },
  "task_tiers": {
    "adversarial": "critical",
    "exploration": "economy",
    "grading": "critical",
    "implementation": "economy",
    "memory-extraction": "economy",
    "planning": "critical",
    "read": "economy",
    "refinement": "critical",
    "research": "economy",
    "review": "critical",
    "simplification": "economy",
    "validation": "critical"
  },
  "pi_constraints": {
    "allowed_providers": ["datadog-ai-gateway"],
    "allowed_model_prefixes": ["openai/"],
    "allowed_models": ["openai/gpt-5.6-luna", "openai/gpt-5.6-sol"]
  },
  "allowed_efforts": ["high", "xhigh", "max"],
  "allowed_pi_thinking": ["low", "medium", "high", "xhigh"],
  "parallelism": {
    "max_leaf_workers": 3,
    "coordinator_reserved_slots": 1,
    "unknown_capacity_probe": 1,
    "failure_policy": "stop-dispatch-drain-active-skip-undispatched"
  }
}
