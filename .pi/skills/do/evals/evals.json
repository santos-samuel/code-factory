{
  "schema_version": 3,
  "skill_name": "do",
  "scenarios": [
    {
      "id": "fast-approved-fix",
      "prompt": "The user approved a three-file bug-fix plan with binary acceptance criteria and named focused tests. The repository is already on a clean feature branch. Route the complete /do run through PR delivery.",
      "assertions": [
        {"field": "profile", "op": "eq", "value": "fast"},
        {"field": "implementation_leaves", "op": "eq", "value": 1},
        {"field": "reviewer_sessions", "op": "eq", "value": 1},
        {"field": "max_agent_depth", "op": "lte", "value": 1},
        {"field": "controller_dispatches", "op": "eq", "value": 0},
        {"field": "pr_status_fetches", "op": "eq", "value": 1},
        {"field": "ci_polling", "op": "eq", "value": false},
        {"field": "red_before_implementation", "op": "eq", "value": true},
        {"field": "green_before_full_validation", "op": "eq", "value": true},
        {"field": "review_after_validation", "op": "eq", "value": true},
        {"field": "delivery_after_review", "op": "eq", "value": true}
      ]
    },
    {
      "id": "standard-evidence-gap",
      "prompt": "A moderate cross-package change is approved, but one decision-critical local error-handling convention is unknown. All external research is complete. Route /do without repeating satisfied work.",
      "assertions": [
        {"field": "profile", "op": "eq", "value": "standard"},
        {"field": "research_leaves", "op": "lte", "value": 1},
        {"field": "implementation_leaves", "op": "eq", "value": 1},
        {"field": "reviewer_sessions", "op": "eq", "value": 1},
        {"field": "evidence_repeated", "op": "eq", "value": false},
        {"field": "max_agent_depth", "op": "lte", "value": 1}
      ]
    },
    {
      "id": "deep-independent-work",
      "prompt": "An authentication change also introduces concurrency control and spans three independent, disjoint packages. The user invokes /do --deep. Route implementation and review.",
      "assertions": [
        {"field": "profile", "op": "eq", "value": "deep"},
        {"field": "implementation_leaves", "op": "eq", "value": 3},
        {"field": "reviewer_sessions", "op": "eq", "value": 1},
        {"field": "max_agent_depth", "op": "lte", "value": 1},
        {"field": "overlapping_file_ownership", "op": "eq", "value": false},
        {"field": "controller_dispatches", "op": "eq", "value": 0}
      ]
    },
    {
      "id": "review-rejection-cap",
      "prompt": "The final reviewer proves a defect. The top agent fixes it, but the focused recheck proves the same contract still fails. Describe the required /do outcome.",
      "assertions": [
        {"field": "reviewer_sessions", "op": "eq", "value": 1},
        {"field": "review_rechecks", "op": "eq", "value": 1},
        {"field": "replacement_reviewers", "op": "eq", "value": 0},
        {"field": "delivery_blocked", "op": "eq", "value": true}
      ]
    },
    {
      "id": "existing-pr-followup",
      "prompt": "The user approves a small follow-up fix on an existing PR with valid /do state and a clean worktree. Implement, validate, and deliver it to the same PR.",
      "assertions": [
        {"field": "profile", "op": "eq", "value": "fast"},
        {"field": "state_reused", "op": "eq", "value": true},
        {"field": "phase_restarts", "op": "eq", "value": 0},
        {"field": "same_pr_updated", "op": "eq", "value": true},
        {"field": "pr_status_fetches", "op": "eq", "value": 1},
        {"field": "pr_fix_invocations", "op": "eq", "value": 0},
        {"field": "ci_polling", "op": "eq", "value": false}
      ]
    },
    {
      "id": "bounded-waiting",
      "prompt": "A permitted Deep leaf times out once. A single status check shows an active tool and fresh progress. The next completion wait also times out. Route the next action.",
      "assertions": [
        {"field": "status_checks", "op": "eq", "value": 1},
        {"field": "additional_completion_waits", "op": "eq", "value": 1},
        {"field": "status_only_followups", "op": "eq", "value": 0},
        {"field": "agent_list_loops", "op": "eq", "value": 0},
        {"field": "replacement_while_active", "op": "eq", "value": false},
        {"field": "reported_blocker", "op": "eq", "value": true}
      ]
    },
    {
      "id": "bounded-full-artifacts",
      "prompt": "Describe the completed artifact set for a Standard /do run, including size limits, event granularity, and unrelated discoveries.",
      "assertions": [
        {
          "field": "required_non_task_artifacts",
          "op": "contains_all",
          "value": ["FEATURE.md", "RESEARCH.md", "CONVENTIONS.md", "PLAN.md", "REVIEW.md", "VALIDATION.md", "SNAPSHOT.md", "events.jsonl"]
        },
        {
          "field": "artifact_caps",
          "op": "map_eq",
          "value": {"FEATURE.md": 150, "RESEARCH.md": 150, "CONVENTIONS.md": 150, "PLAN.md": 150, "REVIEW.md": 100, "VALIDATION.md": 100, "SNAPSHOT.md": 60, "tasks/TASK-*.md": 80}
        },
        {"field": "reused_gates_still_have_artifacts", "op": "eq", "value": true},
        {"field": "task_bundles_conditional", "op": "eq", "value": true},
        {"field": "tool_events_recorded", "op": "eq", "value": false},
        {"field": "wait_events_recorded", "op": "eq", "value": false},
        {"field": "unrelated_findings_expand_scope", "op": "eq", "value": false}
      ]
    },
    {
      "id": "workspace-handoff",
      "prompt": "The repository is on a clean default branch and the user invokes /do --workspace for an approved feature. Describe the complete handoff and the condition for stopping locally.",
      "assertions": [
        {"field": "workspace_skill_invocations", "op": "eq", "value": 1},
        {"field": "local_checkout_or_state_mutated", "op": "eq", "value": false},
        {"field": "feature_context_forwarded", "op": "eq", "value": true},
        {"field": "remote_start_confirmed", "op": "truthy", "value": true},
        {"field": "local_run_stops_after_remote_start", "op": "eq", "value": true},
        {"field": "recursive_workspace_flag_forwarded", "op": "eq", "value": false},
        {"field": "join_command_reported", "op": "eq", "value": true}
      ]
    },
    {
      "id": "branch-only-default",
      "prompt": "The repository is on a clean default branch and the user invokes /do --branch for a new feature. Describe local setup before implementation.",
      "assertions": [
        {"field": "feature_branch_created", "op": "eq", "value": true},
        {"field": "worktree_created", "op": "eq", "value": false},
        {"field": "current_checkout_reused", "op": "eq", "value": true}
      ]
    },
    {
      "id": "bare-resume-discovery",
      "prompt": "The user says only 'resume feature work'. No state path is named, and two active /do state directories match the current repository. Describe the routing outcome.",
      "assertions": [
        {"field": "state_discovery_performed", "op": "eq", "value": true},
        {"field": "new_run_created", "op": "eq", "value": false},
        {"field": "user_choice_requested", "op": "eq", "value": true},
        {"field": "duplicate_worktree_created", "op": "eq", "value": false}
      ]
    },
    {
      "id": "advisory-token-budget",
      "prompt": "A Deep run has --token-budget 50000. Two completed delegates report exact cumulative totals of 30000 and 22000 tokens; top-agent, tool, active-agent, and future usage are unavailable. Describe accounting before another optional leaf.",
      "assertions": [
        {"field": "measured_completed_delegate_tokens", "op": "eq", "value": 52000},
        {"field": "accounting_includes_only_completed_delegates", "op": "eq", "value": true},
        {"field": "unknown_usage_estimated", "op": "eq", "value": false},
        {"field": "hard_ceiling_claimed", "op": "eq", "value": false},
        {"field": "next_optional_leaf_dispatched", "op": "eq", "value": false},
        {
          "field": "excluded_usage",
          "op": "len_eq",
          "value": 4
        }
      ]
    }
  ]
}
